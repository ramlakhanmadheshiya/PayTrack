extends SceneTree
const P = preload("res://scripts/domain/payroll.gd")
const R = preload("res://scripts/storage/repository.gd")
const S = preload("res://scripts/services/payroll_service.gd")
var count = 0
var failures = 0
func check(value: bool, label: String) -> void:
	count += 1
	if not value:
		failures += 1
		printerr("FAIL: ", label)
func _init():
	for v in [[32000,64,33032],[22000,74,26258],[22000,64,22710],[41000,120,79355],[20000,62,20000]]:
		check(P.master(v[0],"2026-10-01","2026-10-31",v[1]).total == v[2], "October BM " + str(v))
	for v in [["2026-11-08","2026-11-17",20,7333],["2026-10-21","2026-11-07",36,12774],["2026-10-21","2026-11-20",62,22000],["2026-11-18","2026-12-17",60,22000],["2027-02-21","2027-03-20",56,22000],["2028-02-01","2028-02-29",0,22000],["2026-01-31","2026-02-27",0,22000],["2026-01-31","2026-03-30",0,44000],["2026-01-01","2026-03-10",0,51097]]:
		check(P.master(22000,v[0],v[1],v[2]).total == v[3],"BM cycles " + str(v))
	check(P.master(22000,"2026-11-01","2026-11-30",70).extra_half_units == 10,"30 days, five extra")
	for v in [[285,136,0,19380],[380,0,480,253],[285,0,120,48],[420,0,360,210],[285,1,0,143]]:
		check(P.worker(v[0],v[1],v[2]).total == v[3],"worker " + str(v))
	check(P.money(123456) == "₹1,23,456", "Indian grouping")
	check(not P.valid_date("2026-02-30") and P.valid_date("2028-02-29"),"dates")
	var r = R.new("user://paytrack-test.json")
	var s = S.new(r)
	check(s.person("Demo One","2026-10-21"),"person")
	check(not s.person("  demo   one  ","2026-10-21"),"duplicate normalized name")
	s.person("Demo Two","2026-10-21")
	var one = r.data.persons[0].id
	var two = r.data.persons[1].id
	check(s.search("").size() == 2,"empty search lists everyone")
	check(s.search("1").size() == 1 and s.search("Demo").size() == 2,"search")
	s.mill("Demo Mill")
	var mill = r.data.mills[0].id
	s.rate(mill,"F",285,"2026-01-01")
	s.rate(mill,"H",420,"2026-01-01")
	s.salary(one,20000,"2026-10-21")
	check(s.attendance(one,mill,"BM","2026-10-21","2026-11-07",36,0),"BM attendance")
	check(s.attendance(one,mill,"F","2026-10-21","2026-11-07",136,120),"uncapped F")
	check(s.attendance(one,mill,"H","2026-10-21","2026-11-07",1,360),"H alongside BM")
	check(not s.attendance(one,mill,"H","2026-10-21","2026-11-07",1,360),"duplicate blocked")
	s.ledger(one,"jama",1000,"2026-11-01")
	s.ledger(one,"kharchi",500,"2026-11-01")
	s.ledger(one,"advance",3000,"2026-11-01",1000)
	var slip = s.preview(one,"2026-11-07")
	check(slip.totals.earnings == 31461,"BM+F+H single base")
	check(slip.totals.net == 30961,"net with all ledgers")
	check(s.record(one,"2026-11-07","2026-11-08",1000,30000),"atomic record")
	check(s.preview(one,"2026-11-17").start == "2026-11-08","period progression")
	check(s.preview(two,"2026-11-17").start == "2026-10-21","other worker independent")
	check(s.preview(one,"2026-11-17").totals.jama == 961,"part payment jama once")
	check(s.preview(one,"2026-11-17").totals.kharchi == 0,"kharchi consumed")
	check(s.preview(one,"2026-11-17").outstanding == 2000,"advance carries")
	check(not s.attendance(one,mill,"F","2026-11-01","2026-11-07",2,0),"paid periods blocked")
	var frozen = JSON.stringify(r.data.settlements[0].slips)
	s.salary(one,25000,"2026-11-01")
	check(JSON.stringify(r.data.settlements[0].slips) == frozen,"salary snapshot frozen")
	check(s.attendance(two,mill,"F","2026-10-21","2026-11-17",56,120),"straddling row")
	check(s.preview(two,"2026-11-07").has("error"),"straddle refuses payment")
	var row = r.data.attendance.back()
	check(s.split(row.id,"2026-11-07",36,60),"manual split")
	check(int(row.half_units) + int(r.data.attendance.back().half_units) == 56,"split units conserved")
	check(int(row.minutes) + int(r.data.attendance.back().minutes) == 120,"split hours conserved")
	var rp = s.reprice_preview(mill,"F","2026-10-21",300)
	check(rp.rows.size() == 2,"reprice only unpaid")
	check(s.reprice(rp,"correction"),"reprice apply")
	check(JSON.stringify(r.data.settlements[0].slips) == frozen,"paid rates frozen")
	var backup = r.backup()
	check(r.restore(backup),"backup restores")
	var working = JSON.stringify(r.data)
	check(not r.restore("broken") and JSON.stringify(r.data) == working,"corrupt restore preserves working data")
	check(r.save(),"save")
	var loaded = R.new("user://paytrack-test.json")
	check(loaded.load_data() and loaded.data.persons.size() == 2,"reload")
	var n = R.new("user://paytrack-test.json")
	var ns = S.new(n)
	ns.person("Negative Demo","2026-11-01")
	var person_id = n.data.persons[0].id
	ns.ledger(person_id,"kharchi",500,"2026-11-01")
	check(not ns.record(person_id,"2026-11-07","2026-11-08"),"negative requires confirmation")
	check(ns.record(person_id,"2026-11-07","2026-11-08",-1,-1,true),"negative records")
	var next = ns.preview(person_id,"2026-11-17")
	check(next.totals.net == 0 and next.outstanding == 500,"negative never double counts")
	var latest = n.data.settlements.back().id
	check(ns.cancel_latest(latest,true),"cancel latest")
	check(ns.preview(person_id,"2026-11-07").totals.kharchi == 500,"cancel restores allocations")
	var f = R.new("user://paytrack-test.json")
	var fs = S.new(f)
	fs.person("Family A","2026-11-01")
	fs.person("Family B","2026-11-01")
	var a = f.data.persons[0].id
	var b = f.data.persons[1].id
	check(fs.family("Demo Family",[a,b]),"create family")
	var fam = f.data.families[0].id
	fs.ledger(a,"jama",100,"2026-11-01")
	fs.ledger(b,"jama",200,"2026-11-01")
	check(fs.preview(a,"2026-11-07").has("error"),"individual family pay blocked")
	var fp = fs.family_preview(fam,"2026-11-07")
	check(fp.cash == 300,"family sums")
	check(fs.record_slips(fp.slips,fam,"2026-11-08",false),"one family cash payment")
	check(f.data.settlements.size() == 1 and f.data.settlements[0].cash == 300,"one cash event")
	check(fs.family_preview(fam,"2026-11-07").has("error"),"family double pay blocked")

	check(fs.family_change(fam,"Demo Family",[]),"dissolve resolved family")
	check(f.data.persons[0].family_id.is_empty(),"family dissolution clears membership")
	var invalid = r.data.duplicate(true)
	invalid.persons[0].erase("payroll_start_date")
	check(not r.validate(invalid),"malformed person rejected")
	invalid = r.data.duplicate(true)
	invalid.attendance[0].half_units = 0.5
	check(not r.validate(invalid),"fractional half units rejected")
	invalid = r.data.duplicate(true)
	invalid.settlements[0].cash = 99
	check(not r.validate(invalid),"payment totals tamper rejected")
	check(not s.record_slips([slip],"","2026-11-08",true),"stale preview blocked")
	check(not s.correct_rate(r.data.attendance[0].id,99,"paid correction"),"paid row correction blocked")
	var c = R.new("user://paytrack-test-cycles.json")
	var cs = S.new(c)
	cs.person("Zero Shift Demo","2026-11-01")
	var cp = c.data.persons[0].id
	cs.salary(cp,22000,"2026-11-01")
	check(cs.preview(cp,"2026-11-30").totals.earnings == 22000,"zero attendance eligible BM paid")
	cs.mill("Cycle Mill")
	var cm = c.data.mills[0].id
	cs.rate(cm,"F",300,"2026-01-01")
	cs.rate(cm,"H",250,"2026-01-01")
	cs.rate(cm,"F",400,"2026-11-10")
	check(not cs.attendance(cp,cm,"F","2026-11-01","2026-11-15",30,0),"rate boundary split required")
	check(cs.attendance(cp,cm,"F","2026-11-01","2026-11-07",14,0),"before boundary attendance")
	var ca = c.data.attendance.back().id
	check(cs.edit_attendance(ca,"2026-11-01","2026-11-07",16,0,"correct received counts"),"audited attendance edit")
	check(c.data.attendance.back().rate == 300,"edit retains snapshot")
	check(not cs.attendance(cp,cm,"F","2026-11-05","2026-11-09",4,0),"overlap warning")
	check(cs.attendance(cp,cm,"F","2026-11-05","2026-11-09",4,0,true),"explicit overlap accepted")
	check(cs.bulk_kharchi([cp],"2026-11-01","2026-11-10",100),"bulk daily kharchi")
	check(cs.preview(cp,"2026-11-07").has("error"),"overlapping straddle also requires split")
	check(cs.preview(cp,"2026-11-09").totals.kharchi == 900,"future kharchi excluded")
	var comp = cs.salary_comparison(cp,24000,"2026-11-01","2026-11-30")
	check(comp.new - comp.old == 2000,"salary comparison exact")
	check(cs.effective("salaries","person_id",cp,"2026-11-30").amount == 22000,"comparison does not mutate")
	var mismatch = R.new("user://paytrack-test-family.json")
	var ms = S.new(mismatch)
	ms.person("Aligned A","2026-11-01")
	ms.person("Aligned B","2026-11-02")
	check(not ms.family("Mismatch",[mismatch.data.persons[0].id,mismatch.data.persons[1].id]),"family mismatched periods blocked")
	mismatch.data.persons[1].payroll_start_date = "2026-11-01"
	ms.ledger(mismatch.data.persons[0].id,"advance",100,"2026-11-01")
	check(not ms.family("Unresolved",[mismatch.data.persons[0].id,mismatch.data.persons[1].id]),"family debt blocks join")
	var stress = R.new("user://paytrack-test-stress.json")
	var ss = S.new(stress)
	for i in 5:
		ss.mill("Fictional Mill " + str(i))
		ss.rate(stress.data.mills.back().id,"F",350,"2026-01-01")
		ss.rate(stress.data.mills.back().id,"H",250,"2026-01-01")
	for i in 100:
		ss.person("Fictional Worker " + str(i),"2026-11-01")
		ss.attendance(stress.data.persons.back().id,stress.data.mills[i%5].id,"F","2026-11-01","2026-11-30",68,120)
	var total = 0
	for person in stress.data.persons:
		total += int(ss.preview(person.id,"2026-11-30").totals.earnings)
	check(total == 1195800,"100 workers / five mills exact preview totals")
	check(stress.restore(stress.backup()) and stress.data.persons.size() == 100,"100-worker backup round trip")

	var sr = R.new("user://paytrack-test-split.json")
	var sp = S.new(sr)
	sp.person("Split Demo","2026-11-01")
	sp.mill("Split Mill")
	var spi = sr.data.persons[0].id
	var smi = sr.data.mills[0].id
	sp.rate(smi,"F",285,"2026-01-01")
	sp.rate(smi,"H",250,"2026-01-01")
	sp.attendance(spi,smi,"F","2026-11-01","2026-11-02",2,0)
	check(sp.split(sr.data.attendance[0].id,"2026-11-01",1,0),"half-shift split succeeds")
	check(sr.data.attendance[1].split_adjustment == -1,"visible split adjustment stored")
	check(sp.preview(spi,"2026-11-02").totals.earnings == 285,"split rounded wages conserve original")
	check(sp.record(spi,"2026-11-01","2026-11-01"),"split first part paid")
	check(sp.preview(spi,"2026-11-02").totals.earnings == 142,"second part carries rounding adjustment once")

	var mixed = R.new("user://paytrack-test-mixed-family.json")
	var mix = S.new(mixed)
	mix.person("Credit Demo","2026-11-01")
	mix.person("Debt Demo","2026-11-01")
	var credit = mixed.data.persons[0].id
	var debt = mixed.data.persons[1].id
	mix.family("Mixed balances",[credit,debt])
	var mid = mixed.data.families[0].id
	mix.ledger(credit,"jama",300,"2026-11-01")
	mix.ledger(debt,"kharchi",100,"2026-11-01")
	var mp = mix.family_preview(mid,"2026-11-07")
	check(mp.cash == 200 and mp.net == 200,"family combined cash respects aggregate net")
	check(mp.slips[0].totals.new_jama == 100 and mp.slips[1].totals.shortfall == 100,"family balances remain individually allocated")
	check(mix.record_slips(mp.slips,mid,"2026-11-08",true),"mixed family records once")
	print("RESULT: ",count - failures,"/",count," assertions passed")
	quit(1 if failures else 0)
