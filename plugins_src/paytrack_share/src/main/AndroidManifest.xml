<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Registers the plugin with Godot: Engine.get_singleton("PayTrackShare"). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.PayTrackShare"
            android:value="com.theramlakhan.paytrack.share.PayTrackSharePlugin" />
        <!-- Invisible screen for the file picker (Import backup). -->
        <activity
            android:name="com.theramlakhan.paytrack.share.PickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
